--- a/main.c
+++ b/main.c
@@ -985,6 +985,10 @@
 
 	struct timespec start_time;
 	clock_gettime(CLOCK_MONOTONIC, &start_time);
+	/* SHADERBG_EPOCH (Unix seconds): iTime counts from that wall-clock moment instead of from
+	 * this process starting, so a shader swapped in by another process carries on the same clock. */
+	const char *epoch_env = getenv("SHADERBG_EPOCH");
+	double epoch = epoch_env ? strtod(epoch_env, NULL) : 0.0;
 
 	struct timespec next_draw_time = start_time;
 	struct timespec last_frame_time = start_time;
@@ -1091,6 +1095,14 @@
 
 		state.current_time = timespec_diff(cur_time, start_time) *
 				     state.speed;
+		if (epoch_env) {
+			struct timespec rt;
+			clock_gettime(CLOCK_REALTIME, &rt);
+			state.current_time = (float)((double)rt.tv_sec +
+						     (double)rt.tv_nsec * 1e-9 -
+						     epoch) *
+					     state.speed;
+		}
 		state.delta_time = timespec_diff(cur_time, last_frame_time) *
 				   state.speed;
 		last_frame_time = cur_time;
